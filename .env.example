# RecoveryOS Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO
APP_NAME=RecoveryOS
CORS_ALLOWED_ORIGINS=*

# Databases
DATABASE_URL=postgresql+asyncpg://recoveryos:recoveryos_dev@localhost:5432/recoveryos
REDIS_URL=redis://localhost:6379/0

# Authentication & Identity (Supabase / Auth0)
AUTH_ISSUER=https://auth.recoveryos.test
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://auth.recoveryos.test/.well-known/jwks.json

# Razorpay Test Mode Credentials (Optional for local testing / CLI)
# Aliases must be allowlisted in EnvProviderCredentialResolver
# WARNING: Phase 5 STRICTLY prohibits live keys ('rzp_live_'). Only 'rzp_test_' keys are permitted.
RAZORPAY_TEST_DEMO_KEY_ID=
RAZORPAY_TEST_DEMO_KEY_SECRET=
RAZORPAY_TEST_STAGING_KEY_ID=
RAZORPAY_TEST_STAGING_KEY_SECRET=
