# ==============================================================================
# RECOVERYOS — Environment Configuration Template
# ==============================================================================
# Environments: local | test | staging | production
APP_ENV=local

# API Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# PostgreSQL Connection (Asyncpg driver for SQLAlchemy 2.x)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/recoveryos
# Synchronous DB URL for Alembic migrations
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoveryos

# Redis Connection (Async Redis client)
REDIS_URL=redis://localhost:6379/0

# Security & CORS (Comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ==============================================================================
# FUTURE PHASE PLACEHOLDERS (Deferred — Not required for Phase 0)
# ==============================================================================
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
